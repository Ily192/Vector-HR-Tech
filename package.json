{
  "name": "vortex-ops",
  "version": "0.1.0",
  "private": true,
  "description": "Vortex Ops — Operations Engine agentic by Vector HR Tech",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.7.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --",
    "test:coverage": "turbo run test -- --coverage",
    "test:watch": "turbo run test --parallel -- --watch",
    "e2e": "turbo run e2e --",
    "e2e:smoke": "turbo run e2e:smoke --",
    "e2e:flujo": "pnpm --filter @vortex/e2e e2e:flujo",
    "storybook": "turbo run storybook --parallel",
    "tokens:build": "pnpm --filter @vortex/design-tokens build",
    "db:start": "supabase start --workdir infra",
    "db:stop": "supabase stop --workdir infra",
    "db:reset": "supabase db reset --workdir infra",
    "db:status": "supabase status --workdir infra",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^19.4.0",
    "@commitlint/config-conventional": "^19.4.0",
    "@size-limit/file": "^11.2.0",
    "husky": "^9.1.0",
    "lint-staged": "^16.4.0",
    "size-limit": "^11.1.0",
    "supabase": "2.120.0",
    "turbo": "^2.1.0",
    "typescript": "^5.5.0"
  },
  "pnpm": {
    "overrides": {
      "source-map-js@<1.2.2": "^1.2.2",
      "fast-uri@<3.1.9": "^3.1.9",
      "postcss-selector-parser@<6.1.5": "^6.1.5"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md}": ["biome check --write --no-errors-on-unmatched"]
  },
  "commitlint": {
    "extends": ["@commitlint/config-conventional"]
  },
  "size-limit": [
    {
      "name": "career-site · JS estático (brotli)",
      "path": "apps/career-site/.next/static/**/*.js",
      "limit": "180 KB"
    },
    {
      "name": "hrbp · bundle principal (brotli)",
      "path": "apps/hrbp/dist/assets/entrada-*.js",
      "limit": "90 KB"
    }
  ]
}
