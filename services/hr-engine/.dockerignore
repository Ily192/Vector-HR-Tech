# Fuera de la imagen: el entorno local de uv, los secretos de desarrollo, los tests y
# las cachés. Sin esto, un `docker build` en una máquina de desarrollo copiaba el .venv
# y el .env dentro de la imagen (`COPY . .` del Dockerfile).
.venv
.env
.env.*
tests
.pytest_cache
.ruff_cache
.mypy_cache
**/__pycache__
*.pyc
htmlcov
.coverage
