# hr-engine — copiar a .env y completar. NUNCA commitear .env (usar Doppler).
# Los nombres coinciden con la raíz `.env.example` del monorepo.

ENV=development                    # development | staging | production
LOG_LEVEL=info                     # debug | info | warning | error
SERVICE_NAME=hr-engine

# ─── DB / Redis ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://vortex:vortex@localhost:5432/vortex_dev
REDIS_URL=redis://localhost:6379/0

# ─── Auth · run-tokens de Paperclip (ADR-005) ─────────────────────────────
# En ENV=production el arranque FALLA si JWT_SECRET es un placeholder o mide
# menos de 32 chars (ver app/config.py::_validate_production_hardening).
JWT_SECRET=change-me
JWT_ALGORITHM=HS256                # HS256 | RS256
RUN_TOKEN_TTL_SECONDS=300
JWT_LEEWAY_SECONDS=10              # tolerancia de clock skew al validar exp

# ─── HTTP / CORS ───────────────────────────────────────────────────────────
# CSV de orígenes permitidos. En producción no puede incluir localhost ni "*"
# junto con CORS_ALLOW_CREDENTIALS=true.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_ALLOW_CREDENTIALS=true

# ─── Rate limiting (slowapi) ───────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL=120/minute       # por IP, middleware sobre toda la app
RATE_LIMIT_TENANT_RUNS=20/minute   # por empresa_id del run-token, en /run
# Vacío = memoria (solo válido con 1 proceso). OBLIGATORIO en producción.
RATE_LIMIT_STORAGE_URI=

# ─── LLMs ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
GOOGLE_API_KEY=
DEFAULT_SCORING_MODEL=gemini-2.5-flash
REASONING_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_SECONDS=30          # el default del SDK son 600 s
GEMINI_TIMEOUT_SECONDS=60
LLM_MAX_ATTEMPTS=3                 # intentos totales (1 + 2 retries)

# ─── Control plane ─────────────────────────────────────────────────────────
PAPERCLIP_URL=http://localhost:4000
PAPERCLIP_API_KEY=

# ─── Observability ─────────────────────────────────────────────────────────
# ⚠️ Nombres alineados con la raíz del monorepo. `app/config.py` acepta además
# los alias legacy SENTRY_DSN y OTEL_ENDPOINT, pero los canónicos son estos.
SENTRY_DSN_BACKEND=
OTEL_EXPORTER_OTLP_ENDPOINT=       # vacío = OTel desactivado (no-op)
OTEL_EXPORTER_OTLP_HEADERS=        # formato: key1=value1,key2=value2

# ─── Celery ────────────────────────────────────────────────────────────────
CELERY_CONCURRENCY=4
CELERY_TASK_TIME_LIMIT=600         # hard kill (s)
CELERY_TASK_SOFT_TIME_LIMIT=540    # soft kill (s), debe ser < time_limit
CELERY_RESULT_EXPIRES=3600         # TTL de resultados en Redis (s)
CELERY_VISIBILITY_TIMEOUT=900      # debe ser > task_time_limit
CELERY_TASK_DEFAULT_RATE_LIMIT=30/m

# ─── Cost caps ─────────────────────────────────────────────────────────────
DEFAULT_RUN_COST_CAP_USD=0.05
MAX_RUN_COST_CAP_USD=5.0           # techo duro: recorta el cap del run-token
