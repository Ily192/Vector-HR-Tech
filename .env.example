# Vortex Ops — local env. Copiar a .env y completar valores reales.
# NUNCA commitear .env. Usar Doppler para gestión real de secretos.

# ─── Supabase ──────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Postgres (engines) ───────────────────
DATABASE_URL=postgresql+asyncpg://vortex:vortex@localhost:5432/vortex_dev

# ─── Redis (Celery + cache) ───────────────
REDIS_URL=redis://localhost:6379/0

# ─── JWT / Auth ───────────────────────────
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_DAYS=7

# ─── LLM providers ────────────────────────
OPENAI_API_KEY=
OPENAI_ORG_ID=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# ─── Channels ─────────────────────────────
GOOGLE_CHAT_WEBHOOK=
TELEGRAM_BOT_TOKEN=
WHATSAPP_PROVIDER=                # 360dialog | twilio | meta
WHATSAPP_API_KEY=

# ─── External APIs (sales-engine) ─────────
APOLLO_API_KEY=
ZEROBOUNCE_API_KEY=
REPLYIO_API_KEY=

# ─── Observability ────────────────────────
SENTRY_DSN_FRONTEND=
SENTRY_DSN_BACKEND=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
POSTHOG_KEY=
POSTHOG_HOST=https://app.posthog.com

# ─── Feature flags ────────────────────────
UNLEASH_URL=
UNLEASH_API_TOKEN=

# ─── Paperclip + OpenClaw ─────────────────
PAPERCLIP_URL=http://localhost:4000
PAPERCLIP_API_KEY=
OPENCLAW_URL=http://localhost:5000
OPENCLAW_API_KEY=

# ─── Misc ─────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
