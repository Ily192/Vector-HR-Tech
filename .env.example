# Vortex Ops — local env. Copiar a .env y completar valores reales.
# NUNCA commitear .env. Usar Doppler para gestión real de secretos.
#
# Este archivo cubre el monorepo entero. Ojo con los tres destinos distintos:
#
#   · FRONTEND (Vercel)  → solo las NEXT_PUBLIC_* y VITE_*. Van al bundle y son
#                          públicas por definición. Nunca poner secretos ahí.
#   · BACKEND (hr-engine)→ ver services/hr-engine/.env.example, que es el que
#                          `app/config.py` lee de verdad.
#   · CI (GitHub Actions)→ los mismos valores, vía Doppler → repository secrets.

# ════════════════════════════════════════════════════════════════════════════
# FRONTEND — expuesto al browser
# ════════════════════════════════════════════════════════════════════════════
# Las declara `turbo.json` en globalPassThroughEnv y las resuelve
# `packages/supabase-client/src/env.ts`. Sin ellas los frontends no arrancan.
# Next.js lee el prefijo NEXT_PUBLIC_; Vite lee VITE_.

# career-site (Next.js)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_HR_ENGINE_URL=http://localhost:8000
NEXT_PUBLIC_SENTRY_DSN=
# Usada por metadataBase en apps/career-site/src/app/layout.tsx (SEO en prod).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=hola@vectorhr.tech

# hrbp (Vite)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_HR_ENGINE_URL=http://localhost:8000
VITE_SENTRY_DSN=

# ════════════════════════════════════════════════════════════════════════════
# Supabase — lado servidor
# ════════════════════════════════════════════════════════════════════════════
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
# ⚠️  BYPASSRLS: esta clave ignora TODAS las políticas de row-level security y
# ve todos los tenants a la vez. Solo en código de servidor. Si acaba en un
# bundle de frontend, el aislamiento multi-tenant completo queda anulado.
SUPABASE_SERVICE_ROLE_KEY=
# Solo para `pnpm --filter @vortex/supabase-client gen:types`.
SUPABASE_PROJECT_REF=

# ─── Postgres (engines) ───────────────────
DATABASE_URL=postgresql+asyncpg://vortex:vortex@localhost:5432/vortex_dev

# ─── Redis (Celery + cache) ───────────────
REDIS_URL=redis://localhost:6379/0

# ─── JWT / run-tokens (ADR-005) ───────────
# ⚠️  En producción esto NO puede quedarse con el valor de ejemplo: es la clave
# con la que se firman los run-tokens de los que sale el empresa_id, y todo el
# aislamiento entre tenants cuelga de ella.
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
RUN_TOKEN_TTL_SECONDS=300

# ─── LLM providers ────────────────────────
OPENAI_API_KEY=
OPENAI_ORG_ID=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# ─── Channels ─────────────────────────────
GOOGLE_CHAT_WEBHOOK=
TELEGRAM_BOT_TOKEN=
WHATSAPP_PROVIDER=                # 360dialog | twilio | meta
WHATSAPP_API_KEY=

# ─── External APIs (sales-engine, Cycle 3) ─
APOLLO_API_KEY=
ZEROBOUNCE_API_KEY=
REPLYIO_API_KEY=

# ─── Observability ────────────────────────
# Nombres del backend: `app/config.py` lee SENTRY_DSN y OTEL_ENDPOINT.
# Las variantes _BACKEND / OTEL_EXPORTER_OTLP_* que este archivo declaraba antes
# las descartaba Pydantic en silencio (extra="ignore"), así que el servicio se
# desplegaba creyendo que tenía observabilidad y no la tenía.
SENTRY_DSN=
OTEL_ENDPOINT=
POSTHOG_KEY=
POSTHOG_HOST=https://app.posthog.com

# ─── Feature flags ────────────────────────
# Referenciado por docs/runbooks/rollback.md como kill-switch, pero todavía no
# hay SDK ni consumidor en el código. No es un mecanismo de rollback real hoy.
UNLEASH_URL=
UNLEASH_API_TOKEN=

# ─── Paperclip + OpenClaw (vendoring, Cycle 2) ─
PAPERCLIP_URL=http://localhost:4000
PAPERCLIP_API_KEY=
OPENCLAW_URL=http://localhost:5000
OPENCLAW_API_KEY=

# ─── Misc ─────────────────────────────────
NODE_ENV=development
ENV=development
LOG_LEVEL=info
# Origenes permitidos por CORS en hr-engine (coma-separados).
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:3001
