{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "forceConsistentCasingInFileNames": true,

    "jsx": "preserve",
    "incremental": true,

    "baseUrl": ".",
    "paths": {
      "@vortex/ui": ["packages/ui/src/index.ts"],
      "@vortex/ui/*": ["packages/ui/src/*"],
      "@vortex/types": ["packages/types/src/index.ts"],
      "@vortex/types/*": ["packages/types/src/*"],
      "@vortex/supabase-client": ["packages/supabase-client/src/index.ts"],
      "@vortex/skills-sdk": ["packages/skills-sdk/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist", "build", ".next", ".turbo"]
}
