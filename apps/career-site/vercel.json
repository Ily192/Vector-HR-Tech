{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "cd ../.. && pnpm turbo run build --filter=@vortex/career-site",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "ignoreCommand": "cd ../.. && pnpm turbo-ignore @vortex/career-site",
  "outputDirectory": ".next",
  "regions": ["gru1"],
  "github": {
    "silent": true
  }
}
