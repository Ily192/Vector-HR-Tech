# Plantilla del .env del VPS (ADR-020). El real vive en el servidor, en /opt/vortex/.env,
# con permisos 600, y nunca entra al repo. Lo crea scripts/generar_secretos.py a partir
# de este archivo: copia lo de aquí y genera los secretos que van vacíos en la sección
# "Generados". Lo demás se llena a mano (runbook docs/runbooks/vps.md).
#
# Va completo en cada respaldo, cifrado. Lo único que hay que guardar fuera del servidor
# es RESTIC_PASSWORD y la llave de R2: con eso se recupera todo lo demás.

# ─── Dominios ─────────────────────────────────────────────────────────────
# Sin https:// ni barra final. Los mismos tres van en las variables de GitHub
# (deploy-vps.yml), porque el panel y el career site los llevan dentro del build.
# La prueba local (pruebas/probar_en_local.sh) usa localhost con puerto.
DOMINIO_EMPLEOS=
DOMINIO_PANEL=
DOMINIO_API=
# http solo en la prueba local: en producción el TLS lo termina Cloudflare.
ESQUEMA_PUBLICO=https

# ─── Correo: Resend por SMTP ──────────────────────────────────────────────
# DigitalOcean bloquea los puertos 25, 465 y 587; Resend acepta 2587 con STARTTLS.
SMTP_HOST=smtp.resend.com
SMTP_PORT=2587
SMTP_USER=resend
# La API key de Resend con permiso de envío (re_…).
SMTP_PASS=
# Remitente de un dominio verificado en Resend, p. ej. no-responder@<dominio>.
SMTP_ADMIN_EMAIL=
SMTP_SENDER_NAME=Vortex Ops
ASUNTO_INVITACION=Te invitaron al panel de Vortex Ops
ASUNTO_ENLACE_MAGICO=Tu enlace para entrar a Vortex Ops

# ─── Cloudflare ───────────────────────────────────────────────────────────
# El token del túnel (Zero Trust → Networks → Tunnels → el túnel → Docker).
CLOUDFLARE_TUNNEL_TOKEN=
# Turnstile del formulario de aplicación (la clave secreta; la pública va en GitHub).
TURNSTILE_SECRET_KEY=

# ─── Respaldos: restic en Cloudflare R2 ───────────────────────────────────
# s3:https://<ACCOUNT_ID>.r2.cloudflarestorage.com/<bucket>
RESTIC_REPOSITORY=
# La llave de R2 con permiso de lectura y escritura solo sobre ese bucket.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Opcional: una URL que el respaldo visita al terminar bien (p. ej. Healthchecks.io),
# para enterarse si un día no corrió.
RESPALDO_PING_URL=

# ─── Evaluación con IA del plan de pago (ADR-021) ─────────────────────────
# La key de Gemini del nivel de PAGO: en el gratuito, Google usa los prompts para mejorar
# sus productos. Sin ella no se evalúa nada y las aplicaciones de las empresas con IA esperan.
GOOGLE_API_KEY=
# Opcional: el respaldo si Gemini no responde.
OPENAI_API_KEY=
# Tope de toda la plataforma al mes, en US$. Al llegar, las evaluaciones nuevas esperan.
IA_PRESUPUESTO_MENSUAL_USD=25

# ─── Opcionales ───────────────────────────────────────────────────────────
SENTRY_DSN_BACKEND=
# Puertos de 127.0.0.1 del perfil admin (Studio y el túnel a Postgres).
PUERTO_STUDIO=3000
PUERTO_DB=5432

# ─── Generados (scripts/generar_secretos.py) ──────────────────────────────
# No se escriben a mano. Para rotar uno se borra su valor, se vuelve a correr el script
# y se reinicia lo que lo usa (runbook, "Rotar secretos").
POSTGRES_PASSWORD=
# Firma los JWT de Supabase; ANON_KEY y SERVICE_ROLE_KEY salen de él.
JWT_SECRET=
# Pública por diseño: la usa el navegador (en GitHub, variable SUPABASE_ANON_KEY).
ANON_KEY=
SERVICE_ROLE_KEY=
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=
PG_META_CRYPTO_KEY=
REDIS_PASSWORD=
HR_ENGINE_JWT_SECRET=
# Cifra los respaldos. Copiarla al gestor de contraseñas: sin ella no se restaura nada.
RESTIC_PASSWORD=
