# Caddy en el VPS (ADR-020): la puerta de la API. El career site y el panel están en
# Vercel desde la enmienda del 2026-11-11, así que aquí solo entra DOMINIO_API.
#
# Todo llega por Cloudflare Tunnel (cloudflared → http://caddy:80). Cloudflare termina
# el TLS, así que aquí todo es HTTP y no hay certificados que renovar. El dominio sale
# del .env del servidor (DOMINIO_API).
#
# La prueba local (pruebas/Caddyfile) importa este archivo y le suma el career site y el
# panel, para que el e2e recorra el flujo completo contra el stack.

{
	auto_https off
	# Sin API de administración: la config solo cambia con un despliegue.
	admin off
	servers {
		# Solo llegan cloudflared y los contenedores; la IP real del visitante viene en
		# CF-Connecting-IP.
		trusted_proxies static private_ranges
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

(comunes) {
	# Con `-Server` estas operaciones van diferidas, al enviar la respuesta: sin el `?`,
	# Referrer-Policy pisaba la del upstream. Con `?` es un valor por defecto, "only
	# written if it doesn't yet exist" (caddyserver.com/docs/caddyfile/directives/header):
	# la página de revisión de la moderación (ADR-022) manda no-referrer, porque su token
	# va en la URL, y se respeta.
	header {
		X-Content-Type-Options nosniff
		?Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

# API de Supabase. Solo las rutas que usan el panel, el career site (desde Vercel) y el
# hr-engine: el resto del gateway (y Studio) no se publica.
http://{$DOMINIO_API} {
	import comunes
	request_body {
		max_size 6MB
	}
	@supabase path /auth/v1/* /rest/v1/* /storage/v1/*
	handle @supabase {
		reverse_proxy api-gw:8000
	}
	# El alta desde vectorhrtech.com/publicar-vacantes (ADR-017, 2026-11-12): la llama el
	# servidor de la web con su secreto. Un registro es un JSON corto.
	handle /alta/* {
		request_body {
			max_size 16KB
		}
		reverse_proxy hr-engine-api:8000
	}
	# La revisión de la cola de moderación de vacantes (ADR-022): los enlaces firmados
	# que llegan a hola@. El formulario es un token, una acción y un motivo corto.
	handle /moderacion/* {
		request_body {
			max_size 16KB
		}
		reverse_proxy hr-engine-api:8000
	}
	# Para el monitoreo externo: sin el detalle del /ready del hr-engine.
	handle /salud/hr-engine {
		reverse_proxy hr-engine-api:8000 {
			rewrite /ready
			@sano status 2xx
			handle_response @sano {
				respond "ok" 200
			}
			handle_response {
				respond "no" 503
			}
		}
	}
	handle {
		respond 404
	}
}

# Cualquier otro dominio.
:80 {
	respond 404
}

# Solo dentro de la red de Docker: las plantillas de correo de Auth y la salud de Caddy.
:8090 {
	handle_path /plantillas/* {
		root * /srv/plantillas
		file_server
	}
	handle /salud {
		respond "ok" 200
	}
	handle {
		respond 404
	}
}
