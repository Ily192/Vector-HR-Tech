# Caddy en el VPS (ADR-020): sirve el panel y el diagnóstico, y reparte lo demás por
# dominio.
#
# Todo llega por Cloudflare Tunnel (cloudflared → http://caddy:80). Cloudflare termina
# el TLS, así que aquí todo es HTTP y no hay certificados que renovar. Los dominios
# salen del .env del servidor (DOMINIO_*).

{
	auto_https off
	# Sin API de administración: la config solo cambia con un despliegue.
	admin off
	servers {
		# Solo llegan cloudflared y los contenedores; la IP real del visitante viene en
		# CF-Connecting-IP.
		trusted_proxies static private_ranges
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

(comunes) {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

# Career site (Next.js). Las cabeceras de seguridad las pone next.config.mjs.
http://{$DOMINIO_EMPLEOS} {
	import comunes
	# El CV va dentro de la Server Action, hasta 5 MB (next.config.mjs).
	request_body {
		max_size 6MB
	}
	reverse_proxy career-site:3000
}

# Panel de la empresa: la SPA de Vite, estática.
http://{$DOMINIO_PANEL} {
	import comunes
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}
	root * /srv/panel
	@hasheados path /assets/*
	header @hasheados Cache-Control "public, max-age=31536000, immutable"
	try_files {path} /index.html
	header /index.html Cache-Control "no-cache"
	file_server
}

# Diagnóstico gratuito de vectorhrtech.com: la SPA de Vite, estática, y su único
# endpoint en el mismo dominio. Así el navegador no necesita la URL de la API ni la
# clave pública, y la CSP no conecta con nada más que Turnstile.
http://{$DOMINIO_DIAGNOSTICO} {
	import comunes
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Turnstile carga su script y su iframe de challenges.cloudflare.com. Figtree
		# viene de Google Fonts, y 'unsafe-inline' en estilos es por los `style` de React.
		Content-Security-Policy "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; connect-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	}

	# POST con los parámetros de registrar_diagnostico (migración 0017) como JSON. Caddy
	# pone la clave pública; los frenos están en la base y en el WAF de Cloudflare
	# (runbook). CF-Connecting-IP pasa tal cual: la RPC la lee para su freno por IP.
	handle /api/diagnostico {
		@no_post not method POST
		handle @no_post {
			header Allow POST
			respond 405
		}
		request_body {
			max_size 32KB
		}
		# Sin query string: el único endpoint es la RPC, sin `select` ni filtros.
		rewrite * /rest/v1/rpc/registrar_diagnostico?
		reverse_proxy api-gw:8000 {
			header_up apikey {$ANON_KEY}
			header_up Authorization "Bearer {$ANON_KEY}"
			# Lo que podría cambiar cómo responde PostgREST: el esquema o la respuesta.
			header_up -Prefer
			header_up -Accept-Profile
			header_up -Content-Profile
			header_up -Cookie
		}
	}

	handle {
		root * /srv/diagnostico
		@hasheados path /assets/*
		header @hasheados Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		header /index.html Cache-Control "no-cache"
		file_server
	}
}

# API de Supabase. Solo las rutas que usan el panel, el career site y el hr-engine: el
# resto del gateway (y Studio) no se publica.
http://{$DOMINIO_API} {
	import comunes
	request_body {
		max_size 6MB
	}
	@supabase path /auth/v1/* /rest/v1/* /storage/v1/*
	handle @supabase {
		reverse_proxy api-gw:8000
	}
	# Para el monitoreo externo: sin el detalle del /ready del hr-engine.
	handle /salud/hr-engine {
		reverse_proxy hr-engine-api:8000 {
			rewrite /ready
			@sano status 2xx
			handle_response @sano {
				respond "ok" 200
			}
			handle_response {
				respond "no" 503
			}
		}
	}
	handle {
		respond 404
	}
}

# Cualquier otro dominio.
:80 {
	respond 404
}

# Solo dentro de la red de Docker: las plantillas de correo de Auth y la salud de Caddy.
:8090 {
	handle_path /plantillas/* {
		root * /srv/plantillas
		file_server
	}
	handle /salud {
		respond "ok" 200
	}
	handle {
		respond 404
	}
}
