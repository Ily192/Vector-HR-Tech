# Solo para la prueba local (probar_en_local.sh). En producción el career site y el panel
# están en Vercel (enmienda de ADR-020 del 2026-11-11) y Caddy solo sirve la API. Aquí se
# le suman los dos sitios, para que el e2e del plan gratis recorra el flujo completo
# contra el stack. compose.local.yml monta este archivo como el Caddyfile y el de
# producción como produccion.Caddyfile.

import /etc/caddy/produccion.Caddyfile

# Career site (Next.js). Las cabeceras de seguridad las pone next.config.mjs.
http://{$DOMINIO_EMPLEOS} {
	import comunes
	# El CV va dentro de la Server Action, hasta 4 MB (lib/tipos-de-aplicacion.ts).
	request_body {
		max_size 6MB
	}
	reverse_proxy career-site:3000
}

# Panel de la empresa: la SPA de Vite, estática. En Vercel, las mismas cabeceras y la
# misma caché salen de apps/hrbp/vercel.json.
http://{$DOMINIO_PANEL} {
	import comunes
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}
	root * /srv/panel
	@hasheados path /assets/*
	header @hasheados Cache-Control "public, max-age=31536000, immutable"
	try_files {path} /index.html
	header /index.html Cache-Control "no-cache"
	file_server
}
